# Do obrazu NIE trafiają: środowiska, dane NASK, wyniki, sekrety, pamięć podręczna, zdjęcia bazy twarzy.
.git
.gitignore
.venv
venv
**/__pycache__
**/*.py[cod]
.pytest_cache
.ruff_cache
.mypy_cache
.cache
*.egg-info
.DS_Store
.vscode
.idea
.env
# sekrety Streamlit — nigdy w obrazie
.streamlit/secrets.toml
*.zip
data
workspace
runs
# eksporty (Neo4j, GraphML, JSON, CSV) — wyniki, nie część obrazu
exports/
models/.tmp-*
reference/faces/*
# baza twarzy: do obrazu trafia wyłącznie pusty reference/faces/.gitkeep (negacja poniżej)
reference/
!reference/faces/.gitkeep
