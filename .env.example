# Bloodhound — kopia jako .env (plik .env NIE trafia do repozytorium)
# LLM przez API zgodne z OpenAI (opcjonalnie; bez klucza działają heurystyki)
LLM_BASE_URL=https://oai.endpoints.kepler.ai.cloud.ovh.net/v1
LLM_API_KEY=
LLM_MODEL=Qwen3.5-9B
LLM_EXTRA_BODY={"reasoning_effort": "none"}

# 1 = tryb offline (bez pobierania stron, DNS, RDAP, TLS)
SLAD_OFFLINE=0
# SLAD_WORKSPACE=workspace/default
